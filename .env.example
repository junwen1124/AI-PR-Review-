# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens
# Scopes: repo (private repos) or public_repo (public repos only)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# AI API Key (choose one)
# DeepSeek (recommended, cheap & capable): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Or OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Or generic AI_API_KEY
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: AI model and base URL
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/v1
